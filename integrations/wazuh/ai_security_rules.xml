<!-- Proposed custom manager rules; not installed or tested by wazuh-logtest. -->
<group name="ai_security_lab,">
  <rule id="100600" level="0">
    <decoded_as>json</decoded_as>
    <field name="ai_security.schema_version" type="pcre2">^1\.0$</field>
    <field name="ai_security.event_type" type="pcre2">^(tool_authorization|tool_result)$</field>
    <description>AI lab structured security event</description>
  </rule>
  <rule id="100601" level="3">
    <if_sid>100600</if_sid>
    <field name="ai_security.outcome">^denied$</field>
    <description>AI lab application authorization or result rejection</description>
    <group>ai_authorization_failure,</group>
  </rule>
  <rule id="100602" level="7">
    <if_sid>100601</if_sid>
    <field name="ai_security.denial_reason">^CUSTOMER_SCOPE_DENIED$</field>
    <description>AI lab cross-customer scope denied</description>
    <group>ai_authorization_failure,</group>
  </rule>
  <rule id="100603" level="5">
    <if_sid>100601</if_sid>
    <field name="ai_security.denial_reason">^UNKNOWN_TOOL$</field>
    <description>AI lab unknown tool denied</description>
    <group>ai_authorization_failure,</group>
  </rule>
  <rule id="100604" level="7">
    <if_sid>100601</if_sid>
    <field name="ai_security.denial_reason">^IDENTITY_OVERRIDE$</field>
    <description>AI lab identity override field rejected; possible injection indicator</description>
    <group>ai_authorization_failure,</group>
  </rule>
  <rule id="100605" level="5">
    <if_sid>100601</if_sid>
    <field name="ai_security.denial_reason">^SERVICE_PERMISSION_DENIED$</field>
    <description>AI lab service tool permission denied</description>
    <group>ai_authorization_failure,</group>
  </rule>
  <rule id="100606" level="4">
    <if_sid>100601</if_sid>
    <field name="ai_security.denial_reason">^MALFORMED_REQUEST$</field>
    <description>AI lab malformed tool proposal rejected</description>
    <group>ai_authorization_failure,</group>
  </rule>
  <rule id="100610" level="10" frequency="5" timeframe="60">
    <if_sid>100600</if_sid>
    <field name="ai_security.outcome">^denied$</field>
    <if_matched_group>ai_authorization_failure</if_matched_group>
    <same_field>ai_security.service_id</same_field>
    <description>AI lab repeated failures for the same pseudonymous service</description>
    <group>ai_repeated_failure,</group>
  </rule>
</group>
